config wifi-device 'radio0'
	option type 'mac80211'
	option path 'platform/10300000.wmac'
	option band '2g'
	option channel 'auto'
	option htmode 'HT20'
	option country 'CN'
	option disabled '0'

# AP：段名/ifname 与 api.uc、wifi-guard、wifi-select 保持统一（mmdvm_ap_2g / mmdvm-ap2）
config wifi-iface 'mmdvm_ap_2g'
	option device 'radio0'
	option ifname 'mmdvm-ap2'
	option mode 'ap'
	option ssid 'MMDVM-OpenWrt'
	option encryption 'none'
	option network 'lan'
	option disabled '0'

# 上游 WiFi（STA）：默认停用，刷机后填入 SSID/密码并把 disabled 改为 0
config wifi-iface 'mmdvm_sta'
	option device 'radio0'
	option ifname 'mmdvmsta'
	option mode 'sta'
	option network 'wwan'
	option ssid 'UPSTREAM_SSID'
	option encryption 'psk2'
	option key 'UPSTREAM_PASSWORD'
	option disabled '1'
