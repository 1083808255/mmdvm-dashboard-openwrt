#!/bin/sh
# HLK-7628N 无线默认值：单射频 AP + STA，AP 无密码，STA 默认停用
# 段名与 ifname 必须与 api.uc / mmdvm-wifi-guard / mmdvm-wifi-select 一致：
#   AP = mmdvm_ap_2g (ifname mmdvm-ap2)，STA = mmdvm_sta (ifname mmdvmsta)
[ -f /etc/config/wireless ] || exit 0

radio=$(uci show wireless | sed -n "s/^wireless\.\([^.=]*\)=wifi-device$/\1/p" | head -n1)
[ -n "$radio" ] || radio=radio0

uci set wireless.$radio.type='mac80211'
uci set wireless.$radio.band='2g'
uci set wireless.$radio.channel='auto'
uci set wireless.$radio.htmode='HT20'
uci set wireless.$radio.country='CN'
uci set wireless.$radio.disabled='0'

# 旧段名迁移：mmdvm_ap -> mmdvm_ap_2g，wwan_sta -> mmdvm_sta
# 迁移时保留用户已填的 SSID/密码，避免升级后配置丢失
if [ -n "$(uci -q get wireless.mmdvm_ap)" ] && [ -z "$(uci -q get wireless.mmdvm_ap_2g)" ]; then
	uci rename wireless.mmdvm_ap=mmdvm_ap_2g
fi
if [ -n "$(uci -q get wireless.wwan_sta)" ] && [ -z "$(uci -q get wireless.mmdvm_sta)" ]; then
	uci rename wireless.wwan_sta=mmdvm_sta
fi
uci -q delete wireless.mmdvm_ap
uci -q delete wireless.wwan_sta

# AP（无密码）
uci -q get wireless.mmdvm_ap_2g >/dev/null || {
	uci set wireless.mmdvm_ap_2g='wifi-iface'
	uci set wireless.mmdvm_ap_2g.ssid='MMDVM-OpenWrt'
	uci set wireless.mmdvm_ap_2g.encryption='none'
	uci set wireless.mmdvm_ap_2g.network='lan'
	uci set wireless.mmdvm_ap_2g.disabled='0'
}
uci set wireless.mmdvm_ap_2g.device="$radio"
uci set wireless.mmdvm_ap_2g.ifname='mmdvm-ap2'
uci set wireless.mmdvm_ap_2g.mode='ap'

# STA 占位：保留已经填好的值，没有才创建
uci -q get wireless.mmdvm_sta >/dev/null || {
	uci set wireless.mmdvm_sta='wifi-iface'
	uci set wireless.mmdvm_sta.ssid='UPSTREAM_SSID'
	uci set wireless.mmdvm_sta.encryption='psk2'
	uci set wireless.mmdvm_sta.key='UPSTREAM_PASSWORD'
	uci set wireless.mmdvm_sta.disabled='1'
}
uci set wireless.mmdvm_sta.device="$radio"
uci set wireless.mmdvm_sta.ifname='mmdvmsta'
uci set wireless.mmdvm_sta.mode='sta'
uci set wireless.mmdvm_sta.network='wwan'

uci commit wireless
exit 0
