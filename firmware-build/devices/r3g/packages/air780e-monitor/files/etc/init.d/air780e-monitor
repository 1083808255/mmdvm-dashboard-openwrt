#!/bin/sh /etc/rc.common
# Air780EX 4G 信号监视服务
START=96
STOP=10
USE_PROCD=1

start_service() {
	local enabled
	config_load air780e
	config_get_bool enabled main enabled 0
	[ "$enabled" = "1" ] || return 0

	procd_open_instance
	procd_set_param command /usr/sbin/air780e-monitor
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger air780e
}
