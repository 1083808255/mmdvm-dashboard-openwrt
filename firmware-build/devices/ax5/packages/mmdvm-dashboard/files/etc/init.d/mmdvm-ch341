#!/bin/sh /etc/rc.common
# 放开 ch341 GPIO 轮询周期到 50ms（驱动默认 10ms，会持续打印
# "GPIO poll period is too short" 并空耗 CPU）。
# 模块可能在 USB 枚举后才出现，因此启动后最多等待 30 秒再写入。
START=9
STOP=10

start() {
	# 控制台不再输出内核 error 级消息（ch341 的轮询告警就是这一级）；
	# dmesg / logread 仍然完整保留，排查时不受影响
	echo 3 > /proc/sys/kernel/printk 2>/dev/null
	(
		i=0
		while [ $i -lt 30 ]; do
			if [ -e /sys/module/i2c_ch341_usb/parameters/poll_period ]; then
				echo 50 > /sys/module/i2c_ch341_usb/parameters/poll_period 2>/dev/null
				break
			fi
			sleep 1
			i=$((i+1))
		done
	) >/dev/null 2>&1 &
}

boot() {
	start
}

stop() {
	:
}
