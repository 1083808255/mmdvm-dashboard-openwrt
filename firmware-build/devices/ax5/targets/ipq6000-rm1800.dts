/dts-v1/;

#include "ipq6000-xiaomi.dtsi"

/ {
	model = "Redmi AX5";
	compatible = "xiaomi,rm1800", "qcom,ipq6018";

	chosen {
		/* UART3 改作双工板端口：去掉内核 console，避免串口混流 */
		/delete-property/ stdout-path;
		bootargs-append = " root=/dev/ubiblock0_1";
		bootargs-find-1 = "console=ttyMSM0,115200n8";
		bootargs-replace-1 = "console=";
		bootargs-find-2 = "console=ttyMSM0";
		bootargs-replace-2 = "console=";
	};
};

/* 普通版 AX5：128MB NAND，分区表由 U-Boot 通过 smem 传入 */
&qpic_bam {
	status = "okay";
};

&qpic_nand {
	status = "okay";

	nand@0 {
		reg = <0>;
		nand-ecc-strength = <4>;
		nand-ecc-step-size = <512>;
		nand-bus-width = <8>;

		partitions {
			compatible = "qcom,smem-part";
		};
	};
};

/* 普通版没有 eMMC，保持关闭 */
&sdhc {
	status = "disabled";
};

&wifi {
	qcom,ath11k-fw-memory-mode = <2>;
};

/* USB 3.0：SoC 的 USB0 控制器（qusb2 HS PHY + QMP SS PHY） */
&qusb_phy_0 {
	status = "okay";
};

&ssphy_0 {
	status = "okay";
};

&usb3 {
	status = "okay";
};

/* USB 2.0：SoC 的 USB1 控制器（仅 HS） */
&qusb_phy_1 {
	status = "okay";
};

&usb2 {
	status = "okay";
};

/* CPU 自带的 BLSP I2C 总线（可接 OLED / RTC 等外设） */
&blsp1_i2c2 {
	status = "okay";
};

&blsp1_i2c3 {
	status = "okay";
};

&blsp1_i2c6 {
	status = "okay";
};
