#!/bin/sh
# 生成 MMDVMHost 用的精简 ID 库：
#   - 46/86 开头的中国用户全量
#   - 最近日志和最近通联里出现过的 ID
# 完整库展开约 58MB 堆内存，精简库约 3MB，硬件屏（Nextion/OLED）仍能显示呼号。
CACHE=/etc/mmdvm/dashboard_ids.cache
OUT=/etc/mmdvm/DMRIds.lite
IDS=/tmp/mmdvm_ids_seen.$$

[ -s "$CACHE" ] || exit 0

: > "$IDS"
for f in /var/log/mmdvm/MMDVM-*.log; do
	[ -f "$f" ] || continue
	grep -oE '(from|to) [0-9]{4,7}' "$f" 2>/dev/null | awk '{print $2}'
done | sort -u > "$IDS"

# 仪表盘最近通联缓存里的 ID
grep -hoE '"id": ?"[0-9]+"' /tmp/dashboard_lh.cache /tmp/dashboard_qso.cache 2>/dev/null \
	| grep -oE '[0-9]+' >> "$IDS"
sort -u "$IDS" -o "$IDS"

awk -F'\t' 'NR==FNR{ids[$1]=1;next} (($1 ~ /^(46|86)/) || ($1 in ids)) {print}' \
	"$IDS" "$CACHE" > "$OUT.tmp" 2>/dev/null

n=$(wc -l < "$OUT.tmp" 2>/dev/null || echo 0)
if [ "$n" -gt 1000 ]; then
	mv "$OUT.tmp" "$OUT"
else
	rm -f "$OUT.tmp"
fi
rm -f "$IDS"
