#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

start_service() {
	local enabled config i2c_bus oled_addr oled_reset

	config_load mmdvmhost
	config_get_bool enabled main enabled 0
	[ "$enabled" = "1" ] || return 0

	config_get config main config "/etc/mmdvm/MMDVM.ini"
	[ -f "$config" ] || {
		logger -t mmdvmhost "configuration not found: $config"
		return 0
	}

	# 呼号和 DMR ID 都还是默认值（新机未配置）时不启动，配置后再开机自启
	local configured
	configured="$(awk -F= '
		/^\[General\]/ { f=1; next }
		/^\[/ { f=0 }
		f && $1 == "Callsign" { cs=$2 }
		f && $1 == "Id" { id=$2 }
		END {
			gsub(/[ \t\r]/, "", cs); gsub(/[ \t\r]/, "", id)
			if (cs == "" || toupper(cs) == "N0CALL") cs = ""
			if (id == "" || id == "0" || id == "1234567") id = ""
			print (cs != "" || id != "") ? "1" : "0"
		}' "$config" 2>/dev/null)"
	[ "$configured" = "1" ] || {
		logger -t mmdvmhost "callsign and DMR ID not configured, skipping autostart"
		return 0
	}

	config_get i2c_bus main i2c_bus "1"
	config_get oled_addr main oled_i2c_addr ""
	config_get oled_reset main oled_reset_gpio ""

	mkdir -p /var/log/mmdvm

	# 屏驱动参数：一次传入，procd 的 env 表每次调用会覆盖上一次
	local envs="MMDVM_I2C_BUS=$i2c_bus"
	[ -n "$oled_addr" ] && envs="$envs MMDVM_OLED_I2C_ADDR=$oled_addr"
	[ -n "$oled_reset" ] && envs="$envs MMDVM_OLED_RESET_GPIO=$oled_reset"

	procd_open_instance
	procd_set_param command /usr/bin/MMDVMHost "$config"
	procd_set_param env $envs
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file "$config"
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "mmdvmhost"
}
