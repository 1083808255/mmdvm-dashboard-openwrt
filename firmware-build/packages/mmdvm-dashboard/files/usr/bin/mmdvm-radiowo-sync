#!/bin/sh
# 同步 radiowo 呼号库（含中国用户的省/市/区地址信息）
# 数据源: https://www.radiowo.com/tools/id-library
URL="https://www.radiowo.com/id_library/user.csv"
OUT="/etc/mmdvm/radiowo_user.csv"
TS="/etc/mmdvm/radiowo_user.ts"
TMP="/tmp/radiowo_user.csv"
LOCK="/tmp/mmdvm_radiowo.lock"

[ -f "$LOCK" ] && exit 0
touch "$LOCK"

wget -q -T 40 -O "$TMP" "$URL" 2>/dev/null
if [ -s "$TMP" ] && head -1 "$TMP" | grep -q '^RADIO_ID,CALLSIGN'; then
	mv "$TMP" "$OUT"
	date +%s > "$TS"
	rm -f "$LOCK"
	exit 0
fi

rm -f "$TMP" "$LOCK"
exit 1
