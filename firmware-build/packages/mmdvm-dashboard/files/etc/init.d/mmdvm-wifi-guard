#!/bin/sh /etc/rc.common
# WiFi 守护：开机 2 分钟保底开热点 + 配置错误 120 秒回滚 + 多 STA 择优
# 支持机型：AX5（双频）与 HLK-7628N（单 2.4G）；其它机型 start 直接退出
START=97
STOP=10

is_managed_wifi() {
	for f in /tmp/sysinfo/board_name /tmp/sysinfo/model /etc/board.json /proc/device-tree/compatible; do
		[ -r "$f" ] || continue
		grep -qiE 'ax5|hlk-?7628' "$f" 2>/dev/null && return 0
	done
	return 1
}

# 是否有上游网络：只看 wan / wwan 两个接口的 L3 设备。
# 4G(wwan4g) 明确排除：4G 不算上游，否则只连 4G 时会被判为“有上游”，
# 用户关掉热点就再也进不了管理页面。
has_upstream() {
	for i in wan wwan; do
		d=$(ubus call network.interface.$i status 2>/dev/null | jsonfilter -e '@.l3_device' 2>/dev/null)
		[ -n "$d" ] || continue
		ip -4 addr show dev "$d" 2>/dev/null | grep -q 'inet ' && return 0
	done
	return 1
}

# ath11k 上 wifi reload 不重建 netdev（Resource busy），逐射频 ubus down/up 会残留
# hostapd 接口（already in use），必须 wifi down → 删残留 phy 配置 → wpad restart → wifi up
# 2.4G 上 AP 与 STA 同 phy，AP 的 ACS 扫描会和 STA 扫描抢射频（SCAN-FAILED ret=-16），
# 首次 wifi up 常失败，需重试
restart_radios() {
	i=0
	while [ $i -lt 3 ]; do
		wifi down >/dev/null 2>&1
		sleep 3
		rm -f /var/run/hostapd-phy*.conf 2>/dev/null
		/etc/init.d/wpad restart >/dev/null 2>&1
		sleep 4
		wifi up >/dev/null 2>&1
		sleep 12
		if [ "$(uci -q get wireless.mmdvm_sta.disabled)" != "0" ] || [ -z "$(uci -q get wireless.mmdvm_sta.ssid)" ]; then
			break
		fi
		[ -e /sys/class/net/mmdvmsta ] && break
		i=$((i+1))
	done
	/etc/init.d/network reload >/dev/null 2>&1
}

force_ap() {
	b=$(uci -q get mmdvmwifi.main.ap_band); [ -n "$b" ] || b=2g
	# 没有 5G AP（7628 单射频）时必须按 2.4G 处理，
	# 否则 ap_band=5g 会把唯一的热点关掉，设备直接失联
	[ -n "$(uci -q get wireless.mmdvm_ap_5g.device)" ] || b=2g
	if [ "$b" = "5g" ]; then d2=1; d5=0; else d2=0; d5=1; fi
	# 逐射频重启要 8 秒，loop 每 10 秒调一次，必须只在状态真的变化时重启，
	# 否则射频被反复拉起，STA 永远关联不上
	changed=0
	if uci -q get wireless.mmdvm_ap_2g >/dev/null; then
		[ "$(uci -q get wireless.mmdvm_ap_2g.disabled)" = "$d2" ] || { uci set wireless.mmdvm_ap_2g.disabled=$d2; changed=1; }
	fi
	if uci -q get wireless.mmdvm_ap_5g >/dev/null; then
		[ "$(uci -q get wireless.mmdvm_ap_5g.disabled)" = "$d5" ] || { uci set wireless.mmdvm_ap_5g.disabled=$d5; changed=1; }
	fi
	if [ "$changed" = "1" ] || [ "$1" = "force" ]; then
		uci commit wireless >/dev/null 2>&1
		restart_radios
	fi
	echo 1 > /tmp/mmdvm-ap-force
}

rollback() {
	if [ -f /etc/config/wireless.mmdvm-prev ]; then
		cp /etc/config/wireless.mmdvm-prev /etc/config/wireless
		uci commit wireless >/dev/null 2>&1
	fi
	force_ap force
	rm -f /tmp/mmdvm-wifi-pending
}

loop() {
	local ticks=0
	while :; do
		sleep 10
		ticks=$((ticks + 1))

		# 配置写入后：拿到上游即确认生效；否则 120 秒超时回滚
		if [ -f /tmp/mmdvm-wifi-pending ]; then
			if has_upstream; then
				rm -f /tmp/mmdvm-wifi-pending
			else
				# busybox 无 stat applet，用 date -r 取文件 mtime
				mtime=$(date -r /tmp/mmdvm-wifi-pending +%s 2>/dev/null || date +%s)
				age=$(( $(date +%s) - mtime ))
				[ "$age" -ge 120 ] && rollback
			fi
		fi

		# 开机 2 分钟内无上游则强制开热点（忽略手动关闭状态）
		up=$(cut -d' ' -f1 /proc/uptime 2>/dev/null | cut -d. -f1)
		[ -z "$up" ] && up=9999
		if [ "$up" -lt 120 ] && ! has_upstream; then
			force_ap
		elif [ "$up" -ge 120 ]; then
			# 2 分钟保底期结束后不再强制，之后尊重用户手动设置
			rm -f /tmp/mmdvm-ap-force
		fi

		# 每 6 次（约 60 秒）无上游触发一次 STA 择优；有上游每 18 次（约 180 秒）
		# 切换前保存回滚点并置 pending，新网络 120 秒内拿不到上游则回滚并强制开热点
		if [ -x /usr/bin/mmdvm-wifi-select ]; then
			if has_upstream; then
				if [ $((ticks % 18)) -eq 0 ]; then
					cp -f /etc/config/wireless /etc/config/wireless.mmdvm-prev 2>/dev/null
					touch /tmp/mmdvm-wifi-pending
					/usr/bin/mmdvm-wifi-select >/dev/null 2>&1
					has_upstream && rm -f /tmp/mmdvm-wifi-pending
				fi
			else
				[ $((ticks % 6)) -eq 0 ] && /usr/bin/mmdvm-wifi-select >/dev/null 2>&1
			fi
		fi
	done
}

start() {
	is_managed_wifi || return 0
	[ -f /etc/config/mmdvmwifi ] || return 0
	pidfile=/tmp/mmdvm-wifi-guard.pid
	if [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile" 2>/dev/null)" 2>/dev/null; then
		return 0
	fi
	( loop ) >/dev/null 2>&1 &
	echo $! > "$pidfile"
}

boot() {
	is_managed_wifi || return 0
	echo 1 > /tmp/mmdvm-ap-force
	start
}
stop() {
	pidfile=/tmp/mmdvm-wifi-guard.pid
	[ -f "$pidfile" ] && kill "$(cat "$pidfile" 2>/dev/null)" 2>/dev/null
	rm -f "$pidfile"
}
