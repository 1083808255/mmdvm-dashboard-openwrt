#!/bin/sh
# 首次启动把仪表盘 API 预编译为 ucode 字节码。
# 原因：api.uc 约 130KB，MT7628 单核上每次请求都要重新编译（约 0.5 秒），
# 预编译后单次只约 0.04 秒；源码保留为 api.uc.src，供 ucode 升级后重新编译。
P=/www-dash/api/api.uc
SRC=/www-dash/api/api.uc.src
[ -f "$P" ] || exit 0
[ -x /usr/bin/ucode ] || exit 0
# 已是字节码且比 ucode 解释器新（同一 ucode 版本编译），无需重编
if head -c 64 "$P" | grep -q ucb; then
	[ "$P" -nt /usr/bin/ucode ] && exit 0
else
	cp -f "$P" "$SRC" 2>/dev/null
fi
[ -f "$SRC" ] || exit 0
ucode -c -s -o "$P.bc" "$SRC" 2>/dev/null || exit 0
chmod 755 "$P.bc"
mv -f "$P.bc" "$P"
exit 0
