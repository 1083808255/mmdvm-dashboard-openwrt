#!/bin/sh
# 首次启动：预编译仪表盘 API，并注册守护任务（每 5 分钟检查一次）。
# api.uc 约 130KB，MT7628 单核上每次请求都要重新编译（约 0.5 秒），
# 预编译后单次只约 0.04 秒；源码保留为 api.uc.src，供 ucode 升级后重新编译。
/usr/bin/mmdvm-dashboard-bc-guard 2>/dev/null

CRON=/etc/crontabs/root
LINE='*/5 * * * * /usr/bin/mmdvm-dashboard-bc-guard'
mkdir -p /etc/crontabs
grep -qF "$LINE" "$CRON" 2>/dev/null || echo "$LINE" >> "$CRON"
/etc/init.d/cron restart >/dev/null 2>&1

exit 0
