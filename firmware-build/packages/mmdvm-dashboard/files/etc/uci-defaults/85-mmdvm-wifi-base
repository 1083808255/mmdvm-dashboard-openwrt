#!/bin/sh
# 无线基线（设备差异化）：redmi,ax5-jdcloud（双频）与 hilink,hlk-7628n（单 2.4G）
# 建立热点 + STA 接口 + mmdvmwifi 配置库
# 幂等：已有 mmdvmwifi.main 时只补缺项，不覆盖用户配置

# 支持托管的机型白名单：AX5 / HLK-7628N
is_managed_wifi() {
	for f in /tmp/sysinfo/board_name /tmp/sysinfo/model /etc/board.json /proc/device-tree/compatible; do
		[ -r "$f" ] || continue
		grep -qiE 'ax5|hlk-?7628' "$f" 2>/dev/null && return 0
	done
	return 1
}
is_managed_wifi || exit 0

# 确保无线配置存在；OpenWrt 默认先用 wifi detect 生成探测配置
if [ ! -f /etc/config/wireless ]; then
	wifi detect >/etc/config/wireless 2>/dev/null || true
fi
[ -f /etc/config/wireless ] || exit 0

# 找出 2g / 5g 的 radio section 名
r2=""; r5=""
for r in $(uci show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-device$/\1/p'); do
	b=$(uci -q get "wireless.$r.band")
	[ "$b" = "2g" ] && [ -z "$r2" ] && r2="$r"
	case "$b" in 5g|6g) [ -z "$r5" ] && r5="$r" ;; esac
done
# 回退：按出现顺序取前两个
if [ -z "$r2" ] || [ -z "$r5" ]; then
	set -- $(uci show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-device$/\1/p')
	[ -z "$r2" ] && [ -n "$1" ] && r2="$1"
	[ -z "$r5" ] && [ -n "$2" ] && r5="$2"
fi
[ -z "$r2" ] && exit 0

# radio 基线：auto 信道、CN 区域、默认频宽
uci set "wireless.$r2.band=2g"
uci set "wireless.$r2.channel=auto"
uci set "wireless.$r2.country=CN"
uci set "wireless.$r2.disabled=0"
[ -z "$(uci -q get "wireless.$r2.htmode")" ] && uci set "wireless.$r2.htmode=HT40"
if [ -n "$r5" ]; then
	uci set "wireless.$r5.band=5g"
	uci set "wireless.$r5.channel=auto"
	uci set "wireless.$r5.country=CN"
	uci set "wireless.$r5.disabled=0"
	[ -z "$(uci -q get "wireless.$r5.htmode")" ] && uci set "wireless.$r5.htmode=HE80"
fi

# 删除 wifi config 生成的默认 AP，避免与托管 AP 冲突
for i in $(uci show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-iface$/\1/p'); do
	case "$i" in mmdvm_ap_2g|mmdvm_ap_5g|mmdvm_sta) continue ;; esac
	[ "$(uci -q get "wireless.$i.mode")" = "ap" ] && uci -q delete "wireless.$i"
done

# 托管 AP：默认 2.4G 启用，5G 禁用（二选一）
# 幂等补缺：已有 section 时不覆盖用户配置，仅修正被旧版本错绑到 2.4G 的 5G AP
uci -q get wireless.mmdvm_ap_2g >/dev/null || {
	uci set wireless.mmdvm_ap_2g=wifi-iface
	uci set wireless.mmdvm_ap_2g.device="$r2"
	uci set wireless.mmdvm_ap_2g.mode=ap
	uci set wireless.mmdvm_ap_2g.network=lan
	uci set wireless.mmdvm_ap_2g.ssid=MMDVM-OpenWrt
	uci set wireless.mmdvm_ap_2g.encryption=none
	uci set wireless.mmdvm_ap_2g.disabled=0
}
# 显式 ifname：同 radio 上 AP+STA 共存时自动命名会冲突，netdev 建不起来
[ -z "$(uci -q get wireless.mmdvm_ap_2g.ifname)" ] && uci set wireless.mmdvm_ap_2g.ifname=mmdvm-ap2
if [ -n "$r5" ]; then
	if uci -q get wireless.mmdvm_ap_5g >/dev/null; then
		[ "$(uci -q get wireless.mmdvm_ap_5g.device)" = "$r5" ] || uci set wireless.mmdvm_ap_5g.device="$r5"
		[ -z "$(uci -q get wireless.mmdvm_ap_5g.ifname)" ] && uci set wireless.mmdvm_ap_5g.ifname=mmdvm-ap5
	else
		uci set wireless.mmdvm_ap_5g=wifi-iface
		uci set wireless.mmdvm_ap_5g.device="$r5"
		uci set wireless.mmdvm_ap_5g.ifname=mmdvm-ap5
		uci set wireless.mmdvm_ap_5g.mode=ap
		uci set wireless.mmdvm_ap_5g.network=lan
		uci set wireless.mmdvm_ap_5g.ssid=MMDVM-OpenWrt
		uci set wireless.mmdvm_ap_5g.encryption=none
		uci set wireless.mmdvm_ap_5g.disabled=1
	fi
else
	# 没有独立 5G radio 时删除 5G AP，避免绑到 2.4G 后“二选一”失真
	uci -q delete wireless.mmdvm_ap_5g 2>/dev/null || true
fi

# STA 接口：网络 wwan
uci -q get network.wwan >/dev/null || {
	uci set network.wwan=interface
	uci set network.wwan.proto=dhcp
}
[ -z "$(uci -q get network.wwan.proto)" ] && uci set network.wwan.proto=dhcp
# wwan 显式绑定 mmdvmsta：netifd 跟随 wifi-iface 的 network= 时经常解析不到设备（NO_DEVICE）
uci set network.wwan.device=mmdvmsta
if uci -q get wireless.mmdvm_sta >/dev/null; then
	[ -z "$(uci -q get wireless.mmdvm_sta.network)" ] && uci set wireless.mmdvm_sta.network=wwan
	[ -z "$(uci -q get wireless.mmdvm_sta.ifname)" ] && uci set wireless.mmdvm_sta.ifname=mmdvmsta
else
	uci set wireless.mmdvm_sta=wifi-iface
	uci set wireless.mmdvm_sta.device="$r2"
	uci set wireless.mmdvm_sta.mode=sta
	uci set wireless.mmdvm_sta.network=wwan
	uci set wireless.mmdvm_sta.ifname=mmdvmsta
	uci set wireless.mmdvm_sta.disabled=1
fi
# 上行优先级：有线 > 无线 > 4G（metric 越小越优先）
# 两条上行同时可用时，metric 相同的默认路由会被后起来的接口抢走
# 7628 没有有线 WAN（30-mmdvm-network 已删除 network.wan），
# 无条件写 network.wan.metric 会凭空造出一个无类型的 wan 段，必须先判断存在
[ -n "$(uci -q get network.wan)" ] && uci set network.wan.metric=10
uci set network.wwan.metric=20
[ -n "$(uci -q get network.wwan4g)" ] && uci set network.wwan4g.metric=30
# LAN 不得带 gateway/dns，否则会插一条走 LAN 的默认路由
uci -q delete network.lan.gateway
uci -q delete network.lan.dns

# 把 wwan / wwan4g 加入 wan 防火墙区（幂等）
for z in $(uci show firewall 2>/dev/null | sed -n 's/^firewall\.\([^.=]*\)=zone$/\1/p'); do
	[ "$(uci -q get "firewall.$z.name")" = "wan" ] || continue
	for add in wwan wwan4g; do
		found=0
		for n in $(uci -q get "firewall.$z.network" 2>/dev/null); do
			[ "$n" = "$add" ] && found=1
		done
		[ "$found" = 0 ] && uci add_list "firewall.$z.network=$add"
	done
	break
done

ucicommit() { uci commit "$@" >/dev/null 2>&1; }
ucicommit wireless
ucicommit network
ucicommit firewall

# mmdvmwifi 状态库（UCI 段类型用 mmdvmwifi，和 api.uc 的 uciSections 匹配）
if [ ! -f /etc/config/mmdvmwifi ]; then
	printf "config mmdvmwifi 'main'\n\toption ap_band '2g'\n\toption ap_enabled '1'\n\n" > /etc/config/mmdvmwifi
	uci commit mmdvmwifi >/dev/null 2>&1
fi
[ -z "$(uci -q get mmdvmwifi.main.ap_band)" ] && uci set mmdvmwifi.main.ap_band=2g
[ -z "$(uci -q get mmdvmwifi.main.ap_enabled)" ] && uci set mmdvmwifi.main.ap_enabled=1

# 已连接但没有 profile（从旧固件升级，STA 是手写段）时补一条：
# 面板的“已保存 WiFi”“忘记网络”“网络配置”都按 profile 工作，
# 缺了它当前网络在界面上就成了不可管理的状态
if [ -z "$(uci show mmdvmwifi 2>/dev/null | sed -n 's/^mmdvmwifi\.\([^.=]*\)=wifi-profile$/\1/p')" ]; then
	sta_ssid=$(uci -q get wireless.mmdvm_sta.ssid)
	if [ -n "$sta_ssid" ]; then
		sta_dev=$(uci -q get wireless.mmdvm_sta.device)
		sta_band=$(uci -q get "wireless.$sta_dev.band")
		[ "$sta_band" = "5g" ] || sta_band=2g
		uci set mmdvmwifi.wp0=wifi-profile
		uci set mmdvmwifi.wp0.ssid="$sta_ssid"
		uci set mmdvmwifi.wp0.key="$(uci -q get wireless.mmdvm_sta.key)"
		uci set mmdvmwifi.wp0.band="$sta_band"
	fi
fi
uci commit mmdvmwifi >/dev/null 2>&1

wifi reload >/dev/null 2>&1

# 开机 2 分钟保底：首次刷机立即置位，以后每次开机由 guard 的 boot() 自动置位
echo 1 > /tmp/mmdvm-ap-force

# 启用并立即启动保底守护（脚本内部再做机型判定）
if [ -x /etc/init.d/mmdvm-wifi-guard ]; then
	/etc/init.d/mmdvm-wifi-guard enable >/dev/null 2>&1
	/etc/init.d/mmdvm-wifi-guard start >/dev/null 2>&1
fi
exit 0
