#!/bin/sh /etc/rc.common

START=94
STOP=11
USE_PROCD=1

start_service() {
	local enabled config

	config_load dmrgateway
	config_get_bool enabled main enabled 0
	[ "$enabled" = "1" ] || return 0

	config_get config main config "/etc/mmdvm/DMRGateway.ini"
	[ -f "$config" ] || {
		logger -t dmrgateway "configuration not found: $config"
		return 0
	}

	mkdir -p /var/log/mmdvm

	procd_open_instance
	procd_set_param command /usr/bin/DMRGateway "$config"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file "$config"
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "dmrgateway"
}
