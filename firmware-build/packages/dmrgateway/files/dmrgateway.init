#!/bin/sh /etc/rc.common

START=94
STOP=11
USE_PROCD=1

start_service() {
	local enabled config

	config_load dmrgateway
	config_get_bool enabled main enabled 0
	[ "$enabled" = "1" ] || return 0

	config_get config main config "/etc/mmdvm/DMRGateway.ini"
	[ -f "$config" ] || {
		logger -t dmrgateway "configuration not found: $config"
		return 0
	}

	# 直连模式下不启动 DMRGateway（MMDVMHost 直接连服务器）
	local mmdvm_ini mode
	mmdvm_ini="$(uci -q get mmdvmhost.main.config)"
	[ -n "$mmdvm_ini" ] || mmdvm_ini="/etc/mmdvm/MMDVM.ini"

	# 呼号和 DMR ID 都还是默认值（新机未配置）时不启动，配置后再开机自启
	local configured
	configured="$(awk -F= '
		/^\[General\]/ { f=1; next }
		/^\[/ { f=0 }
		f && $1 == "Callsign" { cs=$2 }
		f && $1 == "Id" { id=$2 }
		END {
			gsub(/[ \t\r]/, "", cs); gsub(/[ \t\r]/, "", id)
			if (cs == "" || toupper(cs) == "N0CALL") cs = ""
			if (id == "" || id == "0" || id == "1234567") id = ""
			print (cs != "" || id != "") ? "1" : "0"
		}' "$mmdvm_ini" 2>/dev/null)"
	[ "$configured" = "1" ] || {
		logger -t dmrgateway "callsign and DMR ID not configured, skipping autostart"
		return 0
	}

	mode="$(awk '/^\[DMR Network\]/{f=1;next} /^\[/{f=0} f && /^Type=/{sub(/^Type=/,""); print; exit}' "$mmdvm_ini" 2>/dev/null)"
	[ "$mode" = "Direct" ] && {
		logger -t dmrgateway "MMDVM.ini is in Direct mode, DMRGateway not started"
		return 0
	}

	mkdir -p /var/log/mmdvm

	procd_open_instance
	procd_set_param command /usr/bin/DMRGateway "$config"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file "$config"
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "dmrgateway"
}
