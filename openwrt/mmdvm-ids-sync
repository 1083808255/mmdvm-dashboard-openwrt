#!/bin/sh
# 每天从 RadioID 下载完整用户库，生成「ID<TAB>呼号」文件供仪表盘直接查询。
# 下载并校验通过后才替换旧文件；失败时保留旧库，避免设备断网后失去呼号查询。
# 运行时不再联网查询任何 ID，文件里没有的就直接放弃（界面只显示 ID）。
OUT=/etc/mmdvm/dashboard_ids.cache
RAW="$OUT.raw.$$"
NEW="$OUT.new.$$"
SRC=https://database.radioid.net/static/user.csv
NEED_KB=8192
LOCK=/tmp/mmdvm-ids-sync.lock

# 原子锁：mkdir 只有一个进程能拿到，避免并发下载互相覆盖临时文件
mkdir "$LOCK.d" 2>/dev/null || exit 0
trap 'rm -f "$RAW" "$NEW"; rmdir "$LOCK.d" 2>/dev/null' EXIT HUP INT TERM

avail=$(df -k / 2>/dev/null | awk 'NR==2 {print $4}')
if [ -n "$avail" ] && [ "$avail" -lt "$NEED_KB" ]; then
	logger -t mmdvm-ids-sync "剩余空间不足（${avail}KB），跳过全球 ID 库下载"
	exit 0
fi

# 下载先落临时文件并检查 curl 退出码；失败只记日志，旧库保持不动
if ! /usr/bin/curl -fsS --max-time 300 -o "$RAW" "$SRC" 2>/dev/null; then
	logger -t mmdvm-ids-sync "ID 库下载失败，保留旧库"
else
	: > "$NEW"
	awk -F, 'NR > 1 && $1 ~ /^[0-9]+$/ && $2 != "" { print $1 "\t" $2 }' "$RAW" >> "$NEW" 2>/dev/null || :
	n=$(wc -l < "$NEW" 2>/dev/null || echo 0)
	if [ "$n" -gt 10000 ]; then
		# 新库行数/体积明显低于旧库（不足 70%）时视为残缺数据，保留旧库
		shrunk=0
		if [ -s "$OUT" ]; then
			old_lines=$(wc -l < "$OUT" 2>/dev/null || echo 0)
			old_bytes=$(wc -c < "$OUT" 2>/dev/null || echo 0)
			new_bytes=$(wc -c < "$NEW" 2>/dev/null || echo 0)
			[ "$n" -lt "$((old_lines * 7 / 10))" ] && shrunk=1
			[ "$new_bytes" -lt "$((old_bytes * 7 / 10))" ] && shrunk=1
		fi
		if [ "$shrunk" -eq 1 ]; then
			logger -t mmdvm-ids-sync "ID 库明显缩水（$n 条 / $new_bytes 字节，旧库 $old_lines 条 / $old_bytes 字节），保留旧库"
		elif mv -f "$NEW" "$OUT"; then
			logger -t mmdvm-ids-sync "ID 库更新完成：$n 条"
		else
			logger -t mmdvm-ids-sync "ID 库替换失败，保留旧库"
		fi
	else
		logger -t mmdvm-ids-sync "ID 库数据异常（$n 条），保留旧库"
	fi
fi

# 同步更新硬件屏用的精简库：本次下载失败时也用旧库刷新一次
/usr/bin/mmdvm-ids-lite >/dev/null 2>&1 || true
exit 0
