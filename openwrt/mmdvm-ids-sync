#!/bin/sh
# 每天从 RadioID 下载完整用户库，生成「ID<TAB>呼号」文件供仪表盘直接查询。
# 更新前先删除旧文件；剩余空间不足时放弃全球库（不下载）。
# 运行时不再联网查询任何 ID，文件里没有的就直接放弃（界面只显示 ID）。
OUT=/etc/mmdvm/dashboard_ids.cache
NEW=$OUT.new
SRC=https://database.radioid.net/static/user.csv
NEED_KB=8192

rm -f "$OUT"

avail=$(df -k / 2>/dev/null | awk 'NR==2 {print $4}')
if [ -n "$avail" ] && [ "$avail" -lt "$NEED_KB" ]; then
	logger -t mmdvm-ids-sync "剩余空间不足（${avail}KB），跳过全球 ID 库下载"
	rm -f "$NEW"
	exit 0
fi

/usr/bin/curl -fsS --max-time 300 "$SRC" 2>/dev/null | \
	awk -F, 'NR > 1 && $1 ~ /^[0-9]+$/ && $2 != "" { print $1 "\t" $2 }' > "$NEW" 2>/dev/null

n=$(wc -l < "$NEW" 2>/dev/null || echo 0)
if [ "$n" -gt 10000 ]; then
	mv "$NEW" "$OUT"
	logger -t mmdvm-ids-sync "ID 库更新完成：$n 条"
else
	rm -f "$NEW"
	logger -t mmdvm-ids-sync "ID 库下载失败或数据异常（$n 条）"
fi

# 同步更新硬件屏用的精简库
/usr/bin/mmdvm-ids-lite >/dev/null 2>&1
